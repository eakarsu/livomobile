NODE_ENV=development
PORT=3030
DATABASE_PATH=/var/lib/livomobile/matters.sqlite
MIGRATE_ON_START=false
ALLOWED_ORIGINS=

# Generate independent random values of at least 32 characters.
IDEMPOTENCY_SECRET=replace-with-an-independent-random-secret
DOCUMENT_PROVIDER_URL=https://document-provider.example/v1/operations
DOCUMENT_PROVIDER_SECRET=replace-with-an-independent-provider-secret
DOCUMENT_PROVIDER_TIMEOUT_MS=3000
DOCUMENT_PROVIDER_MAX_ATTEMPTS=3

# Credential login bootstrap. The launcher stores only a scrypt hash.
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_ORGANIZATION_SLUG=runtime-tenant
ADMIN_ORGANIZATION_NAME=Runtime Tenant
ADMIN_ROLE=AUTHOR
SESSION_TTL_HOURS=12

# AI calls always use the canonical OpenRouter API base.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000

# One-time token bootstrap values. Remove TOKEN_ROLE after use.
TOKEN_ORGANIZATION_SLUG=example-tenant
TOKEN_ORGANIZATION_NAME=Example Tenant
TOKEN_LABEL=initial-author
TOKEN_ROLE=AUTHOR
TOKEN_TTL_DAYS=30
TOKEN_OUTPUT_PATH=/run/secrets/new-livomobile-token
